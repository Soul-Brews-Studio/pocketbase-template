# Project identity: the ONE place to change it. Use scripts/rename.sh rather than editing by hand;
# it also updates the files that cannot read this one (compose.yaml, the add-on's config.yaml,
# the Dockerfile labels, repository.yaml, README title, DOCS.md).
#
# Plain KEY=value lines (double quotes allowed). Read by scripts/*.sh, the container's run.sh
# (a copy is baked into the image by scripts/sync-addon.sh) and CI.
PROJECT_NAME="PocketBase Template"
PROJECT_SLUG=pocketbase_template
PROJECT_DESCRIPTION="PocketBase backend with provisioned logins and owner-only example data"
# Home Assistant add-on slug, also the directory name under addon/.
ADDON_SLUG=pocketbase_template
# This repository (the panel's "Commit to repo" links and the deployed-commit link). Set by
# scripts/ha-buttons.sh (the init workflow runs it with the new repository's URL).
REPO_URL=https://github.com/Soul-Brews-Studio/pocketbase-template
# Host port (compose default, banner URL). The container always listens on 8090.
DEFAULT_PORT=8090
# Default logins created on first start: one email for the admin page and the app user. Passwords:
# docs/running.md#change-the-logins (shared per machine for local runs, random in Home Assistant).
ADMIN_EMAIL=admin@local.test
# Scheme of the app setup link the panel shows as a QR code: <scheme>://setup?u=…&e=…&p=…
SETUP_SCHEME=pocketbase-template
APP_USER_EMAIL=admin@local.test
