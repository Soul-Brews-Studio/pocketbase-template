# Copy to .env (git-ignored). All optional; empty = the default from project.env.
# Logins on the FIRST start (an existing login is never reset). Compose and scripts/pm2.sh use a
# shared dev password ("pocketbase-dev") for both admin and app; set 0 for random ones (shown once).
# Change them before exposing the server: docs/running.md#change-the-logins
PB_DEV_LOGINS=
# Your own shared password instead of "pocketbase-dev" (keep this file private).
PB_DEFAULT_PASSWORD=
ADMIN_EMAIL=
APP_USER_EMAIL=
# Base URL shown in the banner, e.g. http://my-mac.local:8090 when exposed on the LAN.
PUBLIC_URL=
# Host port (compose only).
PORT=
