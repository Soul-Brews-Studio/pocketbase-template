# Copy to .env (git-ignored). All optional; empty = the default from project.env.
# Logins on the FIRST start (an existing login is never reset). scripts/pm2.sh gives admin and app
# this machine's shared dev password (~/.config/pocketbase-template/dev-password); 0 = random ones.
# Compose: random unless PB_DEFAULT_PASSWORD is set. Change them before exposing the server:
# docs/running.md#change-the-logins
PB_DEV_LOGINS=
# One password for admin and app, e.g. the shared one: $(cat ~/.config/pocketbase-template/dev-password)
PB_DEFAULT_PASSWORD=
ADMIN_EMAIL=
APP_USER_EMAIL=
# Base URL shown in the banner, e.g. http://my-mac.local:8090 when exposed on the LAN.
PUBLIC_URL=
# Host port (compose only).
PORT=
